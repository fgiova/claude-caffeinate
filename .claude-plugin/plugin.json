{
  "name": "claude-caffeinate",
  "description": "Keeps your Mac awake while Claude Code works \u2014 off until you ask for it, per session, via /on, /off, /off-all, /hooks-on and /status.",
  "version": "1.4.0",
  "author": {
    "name": "Francesco Giovannini",
    "url": "https://github.com/fgiova"
  },
  "license": "MIT",
  "keywords": [
    "caffeinate",
    "macos",
    "sleep",
    "display",
    "hooks",
    "commands",
    "productivity"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/caffeinate.sh\" _prompt",
            "timeout": 5,
            "statusMessage": "Keeping the Mac awake..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/caffeinate.sh\" _stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/caffeinate.sh\" _end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
